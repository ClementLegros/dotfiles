{
  "position": "top",
  "reload_style_on_change": true,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "height": 36,
  "spacing": 0,

  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "privacy",
    "tray",
    "custom/dnd",
    "idle_inhibitor",
    "network",
    "bluetooth",
    "group/system",
    "battery",
    "wireplumber",
    "custom/lock",
    "custom/power"
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "sort-by-number": true,
    "format-icons": {
      "active": "●",
      "default": "○",
      "urgent": "◉"
    },
    "persistent-workspaces": {
      "*": 5
    }
  },

  // Titre de la fenêtre active. `rewrite` sert surtout à couper le suffixe que
  // chaque appli colle derrière son titre (« — Mozilla Firefox », « - kitty »),
  // qui mange la moitié de la largeur pour zéro information.
  "hyprland/window": {
    "format": "{title}",
    "max-length": 48,
    "separate-outputs": true,
    "icon": false,
    "rewrite": {
      "(.*) — Mozilla Firefox": "$1",
      "(.*) - Visual Studio Code": "$1",
      "(.*) - Cursor": "$1",
      "(.*) — Dolphin": "$1",
      "(.*) - nemo": "$1",
      "^$": ""
    }
  },

  "clock": {
    "format": "{:%H:%M  %a %d %b}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
    "timezone": "Europe/Paris",
    "locale": "fr_FR.UTF-8",
    // Le calendrier de l'infobulle devient navigable : molette pour changer de
    // mois, clic droit pour basculer mois / année.
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "format": {
        "months":  "<span color='#0b4c8c'><b>{}</b></span>",
        "days":    "<span color='#06355c'>{}</span>",
        "weeks":   "<span color='#3d7ba6'><i>S{}</i></span>",
        "weekdays":"<span color='#1e88e5'><b>{}</b></span>",
        "today":   "<span color='#e8442f'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "network": {
    "interface": "wlan*",
    "format-wifi": "󰤨   {essid}",
    "format-disconnected": "󰤭",
    "format-ethernet": "󰈀  eth",
    "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "tooltip-format-disconnected": "Déconnecté",
    // impala : interface terminal officielle pour iwd (dépôt extra).
    "on-click": "~/.config/waybar/script/tui impala ~/.config/waybar/script/wifi-menu"
  },

  // Le clic ouvre bluetui (fenêtre flottante, voir script/tui) : il parle à
  // BlueZ par D-Bus et gère lui-même l'appairage.
  "bluetooth": {
    "format": "󰂲",
    "format-on": "󰂯",
    "format-connected": "󰂱  {device_alias}",
    "tooltip-format": "Bluetooth : {status}\nClic : gestionnaire · clic droit : allumer/éteindre",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "  {device_alias}",
    "on-click": "~/.config/waybar/script/tui bluetui",
    "on-click-right": "rfkill toggle bluetooth"
  },

  // ── Groupe système ──
  // cpu / mémoire / température / profil d'alimentation vivaient chacun dans la
  // barre en permanence. Regroupés en tiroir : seul le CPU est visible, le
  // reste se déplie au survol. C'est la manière dont waybar recommande
  // aujourd'hui de densifier une barre plutôt que d'aligner dix modules.
  "group/system": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 300,
      "transition-left-to-right": false,
      "children-class": "system-child"
    },
    "modules": [
      "cpu",
      "memory",
      "temperature",
      "power-profiles-daemon"
    ]
  },

  "cpu": {
    "format": "󰍛  {usage}%",
    "interval": 2,
    "tooltip": false
  },

  "memory": {
    "format": "󰘚  {used:0.1f}G",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G ({percentage}%)\nSwap : {swapUsed:0.1f}G",
    "interval": 3
  },

  // Chemin absolu et non `hwmon-path` : la numérotation /sys/class/hwmon/hwmonN
  // change d'un démarrage à l'autre selon l'ordre de sondage des pilotes, et le
  // module pointerait un jour sur la batterie ou le SSD.
  "temperature": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 85,
    "format": "󰔏  {temperatureC}°C",
    "interval": 5,
    "tooltip": false
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Profil : {profile}\nPilote : {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "󰈐",
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰌪"
    }
  },

  "battery": {
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "󰚥  {capacity}%",
    "format-full": "󰁹  full",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "format-time": "{H}h{M:02}",
    "tooltip-format": "{capacity}% — {timeTo}\n{power:0.1f} W",
    "states": {
      "warning": 25,
      "critical": 10
    },
    "interval": 5
  },

  // wireplumber plutôt que pulseaudio : sur PipeWire, le module `pulseaudio`
  // passe par la couche de compatibilité pipewire-pulse. wireplumber parle
  // directement au gestionnaire de sessions — un intermédiaire en moins, et le
  // volume ne se désynchronise plus quand on change de périphérique par défaut.
  "wireplumber": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "max-volume": 150,
    "tooltip-format": "{node_name}\n{volume}%",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "~/.config/waybar/script/tui wiremix pavucontrol",
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },

  // Voyant matériel : s'affiche uniquement quand micro, caméra ou capture
  // d'écran sont réellement actifs (source : PipeWire).
  "privacy": {
    "icon-spacing": 6,
    "icon-size": 13,
    "transition-duration": 250,
    "modules": [
      { "type": "screenshare", "tooltip": true },
      { "type": "audio-in", "tooltip": true }
    ]
  },

  // Empêche hypridle de verrouiller/éteindre l'écran — pour une vidéo ou une
  // présentation. Sans ça, il fallait tuer hypridle à la main.
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰛊"
    },
    "tooltip-format-activated": "Veille inhibée",
    "tooltip-format-deactivated": "Veille normale"
  },

  // `interval: once` + `signal` : aucun sondage périodique, le module se
  // rafraîchit uniquement quand on clique dessus (le on-click renvoie
  // SIGRTMIN+8 à waybar).
  "custom/dnd": {
    "exec": "dunstctl is-paused | grep -q true && echo '{\"text\":\"󰂛\",\"class\":\"on\",\"tooltip\":\"Notifications en pause\"}' || echo '{\"text\":\"󰂚\",\"class\":\"off\",\"tooltip\":\"Notifications actives — clic droit : rappeler la dernière\"}'",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "dunstctl set-paused toggle && pkill -RTMIN+8 waybar",
    "on-click-right": "dunstctl history-pop"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8,
    "show-passive-items": false
  },

  "custom/lock": {
    "format": "󰌾",
    "tooltip": "Verrouiller (Super+L)",
    "on-click": "hyprlock"
  },

  // Passe par le menu et non plus par `systemctl poweroff` : un clic accidentel
  // sur ce module coupait la machine sans confirmation.
  "custom/power": {
    "format": "󰐥",
    "tooltip": "Session (Super+M)",
    "on-click": "~/.config/hypr/script/power-menu"
  }
}
