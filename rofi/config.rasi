/* Apparence : fournie par le thème actif.
 * Bascule : `theme-switch <nom>` — voir ~/.config/themes/. */
@theme "~/.config/themes/current/rofi.rasi"

configuration {
    show-icons: true;

    display-ssh: "󰣀 ssh:";
    display-run: "󱓞 run:";
    display-drun: "󰣖 drun:";
    display-window: "󱂬 window:";
    display-combi: "󰕘 combi:";
    display-filebrowser: "󰉋 filebrowser:";
}
