/* ─── rofi — apparence ─── Sakura ────────────────────────────────────────────
 * Chargé par ~/.config/rofi/config.rasi via themes/current/rofi.rasi.
 * Fichier autonome : la palette est inlinée, pour qu'un thème reste un seul
 * fichier déplaçable.
 *
 * Sombre et translucide : une plaque brun-noir que Hyprland floute
 * (`hl.layer_rule`), un filet rouge érable d'1px, aucune ombre. Le seul aplat de couleur est la ligne sélectionnée.
 */

* {
  /* ── Palette ── */
  ink:       #f5e6e0ff;   /* texte : blanc rosé */
  inkdim:    #a8918aff;
  rose:      #f38f78ff;
  sakura:    #e0604fff;
  petal:     #f5bfaeff;
  blush:     #4a2a25cc;
  red:       #ff6b7aff;

  paper:     #1f1513b8;   /* la plaque principale, floutée par Hyprland */
  paperdim:  #2b1d1a99;   /* champ de saisie, un ton au-dessus */
  edge:      #7d4439ff;   /* filet */

  /* ── Rôles couleurs ── */
  background:                  @paper;
  foreground:                  @ink;
  separatorcolor:              @blush;
  border-color:                @edge;
  background-color:            transparent;

  normal-background:           transparent;
  normal-foreground:           @ink;
  alternate-normal-background: transparent;
  alternate-normal-foreground: @ink;
  selected-normal-background:  @blush;
  selected-normal-foreground:  @ink;

  active-background:           transparent;
  active-foreground:           @rose;
  alternate-active-background: transparent;
  alternate-active-foreground: @rose;
  selected-active-background:  @rose;
  selected-active-foreground:  #1f1513ff;

  urgent-background:           transparent;
  urgent-foreground:           @red;
  alternate-urgent-background: transparent;
  alternate-urgent-foreground: @red;
  selected-urgent-background:  @red;
  selected-urgent-foreground:  #1f1513ff;

  spacing: 2;
  font: "Inter 12";
}

window {
    background-color: @paper;
    border:           1px;
    border-color:     @edge;
    border-radius:    10px;
    padding:          20px;
    width:            580px;
}

mainbox {
    padding: 0;
    border:  0;
    spacing: 14px;
}

inputbar {
    padding:          12px 16px;
    spacing:          10px;
    text-color:       @ink;
    background-color: @paperdim;
    border:           1px;
    border-color:     @blush;
    border-radius:    8px;
    children:         [ "prompt", "entry" ];
}

prompt {
    spacing:    0;
    text-color: @rose;
}

entry {
    text-color:        @ink;
    cursor:            text;
    spacing:           0;
    placeholder-color: #a8918acc;
    placeholder:       "Rechercher...";
}

listview {
    padding:      0;
    scrollbar:    false;
    spacing:      4px;
    fixed-height: 0;
    border:       0;
    lines:        8;
}

element {
    padding:       10px 14px;
    cursor:        pointer;
    spacing:       12px;
    border:        0;
    border-radius: 8px;
}

element normal.normal    { background-color: @normal-background;           text-color: @normal-foreground; }
element normal.urgent    { background-color: @urgent-background;           text-color: @urgent-foreground; }
element normal.active    { background-color: @active-background;           text-color: @active-foreground; }
element selected.normal  { background-color: @selected-normal-background;  text-color: @selected-normal-foreground; }
element selected.urgent  { background-color: @selected-urgent-background;  text-color: @selected-urgent-foreground; }
element selected.active  { background-color: @selected-active-background;  text-color: @selected-active-foreground; }
element alternate.normal { background-color: @alternate-normal-background; text-color: @alternate-normal-foreground; }
element alternate.urgent { background-color: @alternate-urgent-background; text-color: @alternate-urgent-foreground; }
element alternate.active { background-color: @alternate-active-background; text-color: @alternate-active-foreground; }

element-text {
    background-color: transparent;
    cursor:           inherit;
    highlight:        inherit;
    text-color:       inherit;
}

element-icon {
    background-color: transparent;
    size:             1.7em;
    cursor:           inherit;
    text-color:       inherit;
}

message {
    padding:          10px 14px;
    border:           1px;
    border-color:     @blush;
    background-color: @paperdim;
    border-radius:    8px;
}

textbox {
    text-color: @ink;
}

scrollbar {
    width:        4px;
    padding:      0;
    handle-width: 8px;
    border:       0;
    handle-color: #a8918aaa;
}

sidebar {
    border:       0;
    border-color: @separatorcolor;
}

button {
    cursor:     pointer;
    spacing:    0;
    text-color: @normal-foreground;
}
button selected {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
    border-radius:    10px;
}

num-filtered-rows  { expand: false; text-color: #a8918acc; }
num-rows           { expand: false; text-color: #a8918acc; }
textbox-num-sep    { expand: false; str: "/"; text-color: #a8918acc; }
case-indicator     { spacing: 0; text-color: @normal-foreground; }
textbox-prompt-colon {
    margin: 0px 0.3000em 0.0000em 0.0000em;
    expand: false;
    str:    ":";
    text-color: inherit;
}
